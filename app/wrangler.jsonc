// Publica o app (dist/) como Worker de arquivos estáticos.
// - `npx wrangler deploy`: beta.klick.ranimontagna.com, para conferir antes.
// - `npx wrangler deploy --env production`: a raiz, klick.ranimontagna.com, por uma rota na zona. O registro DNS da Vercel não
//   é alterado: sem a rota, a raiz volta para a v1.
{
  "name": "klick-app-beta",
  "account_id": "3a9dc0a9d9f05ff97021ce237e3ed92f",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "beta.klick.ranimontagna.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "production": {
      "name": "klick-app",
      "workers_dev": false,
      "routes": [{ "pattern": "klick.ranimontagna.com/*", "zone_name": "ranimontagna.com" }],
      "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
    }
  }
}
