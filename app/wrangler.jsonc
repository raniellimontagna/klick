// Publica o app (dist/) como Worker de arquivos estáticos.
// - `npx wrangler deploy`: beta.klick.ranimontagna.com, para conferir antes.
// - `npx wrangler deploy --env production`: a raiz, klick.ranimontagna.com, por uma rota na zona. A v1 saiu da Vercel em 12/10:
//   o registro DNS do domínio (com proxy) ainda aponta para lá, mas é só o que mantém a rota viva. Não o apague.
{
  "name": "klick-app-beta",
  "account_id": "3a9dc0a9d9f05ff97021ce237e3ed92f",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "beta.klick.ranimontagna.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "production": {
      "name": "klick-app",
      "workers_dev": false,
      "routes": [{ "pattern": "klick.ranimontagna.com/*", "zone_name": "ranimontagna.com" }],
      "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
    }
  }
}
