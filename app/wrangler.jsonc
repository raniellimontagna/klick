// Publica o app (dist/) e o servidor da conta e do sync (worker/index.ts) num Worker só (spec 8.1).
// - `pnpm run deploy:beta` (o build e `wrangler deploy`): beta.klick.ranimontagna.com, para conferir antes.
// - `pnpm run deploy:production` (o build e `wrangler deploy --env production`): a raiz, klick.ranimontagna.com.
// Os dois são domínios próprios do Worker (custom_domain): o Cloudflare cria e mantém o registro DNS de cada um. O script só roda antes
// dos arquivos em /api/* (run_worker_first); o resto sai direto dos arquivos, como antes.
// Cada ambiente tem as próprias ligações (D1, Durable Objects, R2): nada do beta toca os dados da raiz. Os segredos (BETTER_AUTH_SECRET,
// TURNSTILE_SECRET, RESEND_API_KEY) entram só por `npx wrangler secret put NOME [--env production]`: o repositório é público.
// Os tetos do grátis são vars de cada ambiente (spec 4; worker/limits.ts): o espaço das cópias (SNAPSHOT_BYTES_CAP), as operações do R2 por
// mês (R2_CLASS_A_MONTH: gravar e listar; R2_CLASS_B_MONTH: ler) e os códigos por e-mail (MAIL_PER_DAY, MAIL_PER_MONTH). O beta e a raiz
// dividem o Resend e o R2 da conta, cada um com o próprio D1: os dois somados ficam abaixo do grátis (90 e-mails/dia de 100, 2.750/mês de
// 3.000; 550 mil operações A de 1 milhão e 5,5 milhões B de 10 milhões; 1,256 GB de 10 GB, que a conta ainda divide com outros projetos).
// Os tamanhos de conta (Task 12, em registros: sessões, solves, treino e ajustes): acima de SNAPSHOT_MAX_RECORDS a conta não tem cópia do
// dia, e acima de RESTORE_MAX_RECORDS a restauração é recusada. Valem na leitura de 30 s do limite de CPU dos Durable Objects (decidem a
// memória e as linhas do dia: docs/superpowers/measurements/2026-10-17-conta-100k.md). Na leitura de 10 ms, os dois vão a "0" (nenhuma
// cópia, nenhuma restauração), sem mudar código; a cascata de apagar uma sessão grande (uns milhares de solves) não tem var e pediria um
// teto no código (worker/limits.ts). SNAPSHOT_MAX_RECORDS fica em 4747, o que o app consegue restaurar (RECORDS_PER_DAY, worker/limits.ts):
// a memória deixaria copiar até ~55 mil, mas uma cópia que nunca pode voltar só ocuparia o espaço gratuito das cópias de todas as contas
// (uma de 50 mil solves grava ~74 MB em 30 dias). Subir esta var espera uma restauração em partes, e é decisão do Ranielli. No beta ela
// fica em 2247: o teto global de 10 mil linhas do beta (ROWS_WRITTEN_DAY_CAP) restaura no máximo isso num dia.
// O teto de linhas gravadas por dia (ROWS_WRITTEN_DAY_CAP; decisão 6 e o portão 11 do README): as 100 mil linhas que os Durable Objects
// do grátis gravam por dia são da conta inteira (o beta, a raiz e os outros projetos), e passadas elas toda gravação de todo objeto falha
// até a virada do dia UTC. Cada ambiente soma as linhas de todas as contas dele no próprio D1 e para no teto: 10 mil no beta e 60 mil na
// raiz, 70% do dia juntos; o resto do lote sobe no dia seguinte, e os 30% ficam para os outros projetos e para o que o teto não conta (o
// estado das cópias, o alarme, apagar a conta).
// Cada pedido reserva antes exatamente as linhas dele. O maior pedido de um dia (o dia útil, worker/limits.ts, recordsPerDay: a cascata de
// apagar uma sessão e a restauração) segue o menor dos dois tetos: 2.247 registros no beta e 4.747 na raiz; acima dele, a exclusão volta
// com a cota e a restauração é too-big, em vez de esperar um dia que nunca chega.
// Para subir um teto, mude a var e publique. Uma var ausente, vazia ou que não seja um inteiro maior que 0 vale 0: nada passa.
{
  "name": "klick-app-beta",
  "account_id": "3a9dc0a9d9f05ff97021ce237e3ed92f",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  // Antes de todo deploy (e do wrangler dev), a conferência de que dist/ é um build de verdade: o dist/ vazio que os testes do Worker criam
  // nunca vai para o ar. Publique com `pnpm run deploy:beta` ou `pnpm run deploy:production`, que fazem o build antes.
  "build": { "command": "node scripts/check-dist.mjs" },
  "workers_dev": false,
  // Os logs do Worker ficam (os console.log levam só ids, contagens, durações e erros, spec 8.5); o log de invocação, que guardaria cada
  // pedido com os cabeçalhos (o navegador, o IP) por dias, não (spec 10).
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // A limpeza diária (spec 10): os pedidos de código com mais de uma hora e os códigos vencidos, às 00:15 de Brasília (worker/index.ts,
  // scheduled). Não depende de nenhuma conta.
  "triggers": { "crons": ["15 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "klick-auth-beta", "database_id": "8d59ce8e-5ab0-4dbd-b7c2-9daa72a7d54a", "migrations_dir": "worker/migrations" }],
  "routes": [{ "pattern": "beta.klick.ranimontagna.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Um Durable Object com SQLite por conta (spec 8.2). As migrações valem para os dois ambientes; cada um tem o próprio namespace.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountStore"] }],
  "durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "AccountStore" }] },
  // As cópias diárias (spec 8.3). O bucket é criado à mão (`wrangler r2 bucket create`), com a regra que apaga o que passa de 30 dias.
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "klick-snapshots-beta" }],
  "ratelimits": [
    { "name": "API_BURST", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
    { "name": "OTP_BURST", "namespace_id": "1102", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "ACCOUNTS_ENABLED": "true",
    "APP_ORIGIN": "https://beta.klick.ranimontagna.com",
    // A site key do widget "Klick" do Turnstile (invisível, beta e raiz): é pública. O secret dele só existe como segredo do Worker.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFZP094_-Gx1c3Ik",
    "MAIL_FROM": "Klick <nao-responda@ranimontagna.com>",
    "SNAPSHOT_BYTES_CAP": "256000000",
    "R2_CLASS_A_MONTH": "50000",
    "R2_CLASS_B_MONTH": "500000",
    "MAIL_PER_DAY": "10",
    "MAIL_PER_MONTH": "250",
    "SNAPSHOT_MAX_RECORDS": "2247",
    "RESTORE_MAX_RECORDS": "5000",
    "ROWS_WRITTEN_DAY_CAP": "10000"
  },
  "env": {
    "production": {
      "name": "klick-app",
      "build": { "command": "node scripts/check-dist.mjs" },
      "workers_dev": false,
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "triggers": { "crons": ["15 3 * * *"] },
      "d1_databases": [{ "binding": "DB", "database_name": "klick-auth", "database_id": "733fa475-c171-47b2-867a-2c1ab140a05e", "migrations_dir": "worker/migrations" }],
      "routes": [{ "pattern": "klick.ranimontagna.com", "custom_domain": true }],
      "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
      "durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "AccountStore" }] },
      "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "klick-snapshots" }],
      "ratelimits": [
        { "name": "API_BURST", "namespace_id": "2101", "simple": { "limit": 120, "period": 60 } },
        { "name": "OTP_BURST", "namespace_id": "2102", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        "ACCOUNTS_ENABLED": "true",
        "APP_ORIGIN": "https://klick.ranimontagna.com",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFZP094_-Gx1c3Ik",
        "MAIL_FROM": "Klick <nao-responda@ranimontagna.com>",
        "SNAPSHOT_BYTES_CAP": "1000000000",
        "R2_CLASS_A_MONTH": "500000",
        "R2_CLASS_B_MONTH": "5000000",
        "MAIL_PER_DAY": "80",
        "MAIL_PER_MONTH": "2500",
        "SNAPSHOT_MAX_RECORDS": "4747",
        "RESTORE_MAX_RECORDS": "5000",
        "ROWS_WRITTEN_DAY_CAP": "60000"
      }
    }
  }
}
